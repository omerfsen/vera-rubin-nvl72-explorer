{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explorer display settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "description",
    "colors",
    "links",
    "rear"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "hover",
        "dim",
        "linkHalo",
        "conflict",
        "unitTypes",
        "partTypes",
        "portTypes",
        "rearTypes",
        "networks",
        "leds",
        "scene"
      ],
      "properties": {
        "selected": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "hover": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "dim": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "light"
          ],
          "description": "Colour of parts off the shown network, per theme.",
          "properties": {
            "dark": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "light": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            }
          }
        },
        "linkHalo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "light"
          ],
          "properties": {
            "dark": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            },
            "light": {
              "type": "string",
              "pattern": "^#[0-9a-f]{6}$"
            }
          },
          "description": "Thin outline behind every connection tube, per theme, so a tube reads over any part colour."
        },
        "conflict": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "unitTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "partTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "portTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "rearTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "networks": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "leds": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          }
        },
        "scene": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dark",
            "light"
          ],
          "description": "3D scene colours per theme.",
          "properties": {
            "dark": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "background",
                "skyLight",
                "groundLight",
                "floor",
                "rackFrame",
                "handles",
                "trayBase",
                "trayWall",
                "rearBezel"
              ],
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "skyLight": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "groundLight": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "floor": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "rackFrame": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "handles": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "trayBase": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "trayWall": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "rearBezel": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                }
              }
            },
            "light": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "background",
                "skyLight",
                "groundLight",
                "floor",
                "rackFrame",
                "handles",
                "trayBase",
                "trayWall",
                "rearBezel"
              ],
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "skyLight": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "groundLight": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "floor": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "rackFrame": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "handles": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "trayBase": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "trayWall": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "rearBezel": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                }
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "color",
          "shape"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "color": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dark",
              "light"
            ],
            "properties": {
              "dark": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              },
              "light": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              }
            },
            "description": "Colour per theme; kept clear of the part colours, the selection colour and the colours in NVIDIA figures."
          },
          "shape": {
            "enum": [
              "signal",
              "pipe",
              "ribbon"
            ],
            "description": "signal: thin glowing tube; pipe: thicker matte tube (coolant); ribbon: square tube (power)."
          }
        }
      }
    },
    "rear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depthByType",
        "seeThrough",
        "underRack"
      ],
      "properties": {
        "depthByType": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "seeThrough": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "underRack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rackTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types"
      ],
      "description": "Which component types the rack totals chart shows, and in what order. Presentation only: the counts come from the topology data.",
      "properties": {
        "description": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tour": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "description": "The \"Start here\" guided tour. Presentation only: which part each step selects and which view it shows; captions are UI strings and the facts come from the topology data.",
      "properties": {
        "description": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "view",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$",
                "description": "Key of the caption under ui.guidedTour.steps."
              },
              "view": {
                "type": "string",
                "enum": [
                  "rack",
                  "rear",
                  "tray"
                ]
              },
              "target": {
                "type": "string",
                "description": "Selection path, \"\" for the rack itself."
              },
              "network": {
                "type": "string",
                "description": "Network overlay to show, by network id."
              },
              "page": {
                "type": "string",
                "enum": [
                  "sources"
                ]
              }
            }
          }
        }
      }
    }
  }
}
