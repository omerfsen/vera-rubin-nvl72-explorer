{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omerfsen/vera-rubin-nvl72-explorer/data/nvl72-topology.schema.json",
  "title": "NVIDIA DGX Vera Rubin NVL72 topology",
  "description": "Components, networks, rack layout and connections of a DGX VR NVL72 rack. Every fact carries a source; anything the guide does not state is marked assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "networks",
    "components",
    "rackLayout",
    "connections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "document",
        "retrieved"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "date",
            "urls"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            }
          }
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/network"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "rackLayout": {
      "$ref": "#/$defs/rackLayout"
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Lowercase kebab-case. Dots and slashes are reserved for instance paths (compute-tray.7/gpu.2).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "section"
      ],
      "properties": {
        "url": {
          "description": "Page URL, with the section anchor when the page has one.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://docs\\.nvidia\\.com/dgx/dgxvr-user-guide/"
        },
        "section": {
          "description": "Section number and title, plus table or figure.",
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "description": "File name under https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/. Only hot-linked, and only when SHOW_OFFICIAL_FIGURES is on.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.png$"
        }
      }
    },
    "provenance": {
      "description": "A fact needs a source. assumed=true means the guide does not state it; a note is then required.",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "assumed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source"
      ],
      "if": {
        "properties": {
          "assumed": {
            "const": true
          }
        },
        "required": [
          "assumed"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "unit": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source",
          "description": "Overrides the component source for this one spec."
        },
        "assumed": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "assumed": {
            "const": true
          }
        },
        "required": [
          "assumed"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    "network": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "number",
        "name",
        "description",
        "fabric"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "number": {
          "description": "Number used in the guide's network list and port figure.",
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fabric": {
          "description": "null when the guide does not name the fabric for this network.",
          "enum": [
            "InfiniBand",
            "Ethernet",
            null
          ]
        }
      }
    },
    "componentType": {
      "enum": [
        "rack",
        "compute-tray",
        "switch-tray",
        "power-shelf",
        "tor-switch",
        "cpu",
        "gpu",
        "nic",
        "dpu",
        "drive",
        "switch-asic",
        "psu",
        "bmc",
        "controller",
        "port",
        "cable-cartridge",
        "manifold",
        "bus-bar"
      ]
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "count",
        "parent",
        "description",
        "function",
        "networks",
        "specs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/componentType"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "description": "Instances per parent instance. null when the guide does not state it.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "parent": {
          "description": "Parent component id, or null for the rack itself.",
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "networks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spec"
          }
        },
        "rearSide": {
          "description": "Sits at the rear of the rack.",
          "type": "boolean"
        }
      }
    },
    "rackLayout": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "order",
        "groups"
      ],
      "properties": {
        "order": {
          "const": "top-to-bottom"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "count"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/id"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "heightsRU": {
          "description": "Height per component id in rack units. Each value carries its own provenance.",
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/provenance"
              }
            ],
            "type": "object",
            "unevaluatedProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "numbering": {
          "allOf": [
            {
              "$ref": "#/$defs/provenance"
            }
          ],
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "const": "top-to-bottom-per-type"
            }
          }
        }
      }
    },
    "connection": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "from",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id",
          "description": "Component id."
        },
        "to": {
          "$ref": "#/$defs/id",
          "description": "Component id. Omit for a port that the guide marks as not connected."
        },
        "network": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "network",
            "not-connected",
            "nvlink",
            "power",
            "cooling"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
