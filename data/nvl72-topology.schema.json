{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omerfsen/vera-rubin-nvl72-explorer/data/nvl72-topology.schema.json",
  "title": "NVIDIA DGX Vera Rubin NVL72 topology",
  "description": "Components, networks, rack layout and connections of a DGX VR NVL72 rack. Every fact carries a source; anything the guide does not state is marked assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "networks",
    "components",
    "rackLayout",
    "connections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "document",
        "retrieved"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "date",
            "urls"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            }
          }
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "serviceManual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "date",
            "urls"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            }
          }
        }
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/network"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "rackLayout": {
      "$ref": "#/$defs/rackLayout"
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "trayLayouts": {
      "type": "object",
      "description": "Schematic interior layouts, keyed by tray component id.",
      "additionalProperties": {
        "$ref": "#/$defs/trayLayout"
      }
    },
    "rearLayout": {
      "$ref": "#/$defs/rearLayout"
    },
    "pcieDevices": {
      "type": "array",
      "description": "Table 2.4 of the guide, verbatim, mapped to parts.",
      "items": {
        "$ref": "#/$defs/pcieDevice"
      }
    },
    "procedures": {
      "type": "array",
      "description": "Customer-replaceable unit procedures from the service manual.",
      "items": {
        "$ref": "#/$defs/procedure"
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Lowercase kebab-case. Dots and slashes are reserved for instance paths (compute-tray.7/gpu.2).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "section"
      ],
      "properties": {
        "url": {
          "description": "A page of the DGX VR NVL72 User Guide or Service Manual, with the section anchor, or one of their PDFs.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://docs\\.nvidia\\.com/dgx/(dgxvr-user-guide/((hardware|networking|storage)\\.html(#[a-z0-9-]+)?|dgxvr-user-guide\\.pdf)|dgxvr-service-manual/((index|introduction|psu-replacement|pmm-replacement|cache-replacement|compute-battery-replacement|switch-battery-replacement)\\.html(#[a-z0-9-]+)?|dgxvr-service-manual\\.pdf))$"
        },
        "section": {
          "type": "string",
          "pattern": "\\S",
          "description": "Section number and title, plus table or figure."
        },
        "figure": {
          "description": "One of the 13 official figure files under https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/. Only hot-linked, and only when SHOW_OFFICIAL_FIGURES is on.",
          "enum": [
            "hardware-rack-configuration-VRNVL72.png",
            "hardware-rack-rear-VRNVL72.png",
            "hardware-compute-tray-vrnvl72.png",
            "hardware-compute-tray-block-diagram-VRNVL72.png",
            "hardware-compute-tray-top-VRNVL72.png",
            "hardware-compute-tray-front-VRNVL72.png",
            "hardware-nvlink-switch-tray-VRNVL72.png",
            "hardware-power-shelf-VRNVL72.png",
            "hardware-tor-ethernet-VRNVL72.png",
            "network-port-numbers-VRNVL72.png",
            "network-port-types-VRNVL72.png",
            "network-port-labels-1-VRNVL72.png",
            "network-port-labels-2-VRNVL72.png"
          ]
        }
      }
    },
    "provenance": {
      "description": "A fact needs a source. assumed=true means the guide does not state it; a note is then required.",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "assumed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "source"
      ],
      "if": {
        "properties": {
          "assumed": {
            "const": true
          }
        },
        "required": [
          "assumed"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "unit": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source",
          "description": "Overrides the component source for this one spec."
        },
        "assumed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "if": {
        "properties": {
          "assumed": {
            "const": true
          }
        },
        "required": [
          "assumed"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    "network": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "if": {
            "properties": {
              "fabric": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "fabricSource"
            ]
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "number",
        "name",
        "description",
        "fabric"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "number": {
          "description": "Number used in the guide's network list and port figure.",
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fabric": {
          "description": "null when the guide does not name the fabric for this network.",
          "enum": [
            "InfiniBand",
            "Ethernet",
            null
          ]
        },
        "fabricSource": {
          "$ref": "#/$defs/source",
          "description": "Where the fabric is stated, when that is not the network's own source."
        }
      }
    },
    "componentType": {
      "enum": [
        "rack",
        "compute-tray",
        "switch-tray",
        "power-shelf",
        "tor-switch",
        "cpu",
        "gpu",
        "nic",
        "dpu",
        "drive",
        "switch-asic",
        "psu",
        "bmc",
        "controller",
        "port",
        "cable-cartridge",
        "manifold",
        "bus-bar",
        "battery",
        "memory",
        "board",
        "connector",
        "structure"
      ]
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "count",
        "parent",
        "description",
        "function",
        "networks",
        "specs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/componentType"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "description": "Instances per parent instance. null when the guide does not state it.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "parent": {
          "description": "Parent component id, or null for the rack itself.",
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "networks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spec"
          }
        },
        "rearSide": {
          "description": "Sits at the rear of the rack.",
          "type": "boolean"
        },
        "textSources": {
          "description": "Extra sources for facts in description and function that the main source does not state.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        }
      }
    },
    "rackLayout": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "order",
        "groups"
      ],
      "properties": {
        "order": {
          "const": "top-to-bottom"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "count"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/id"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "heightsRU": {
          "description": "Height per component id in rack units. Each value carries its own provenance.",
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/provenance"
              }
            ],
            "type": "object",
            "unevaluatedProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "numbering": {
          "allOf": [
            {
              "$ref": "#/$defs/provenance"
            }
          ],
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "const": "top-to-bottom-per-type"
            },
            "overrides": {
              "type": "object",
              "description": "Per-type numbering that differs from the default scheme.",
              "additionalProperties": {
                "allOf": [
                  {
                    "$ref": "#/$defs/provenance"
                  }
                ],
                "type": "object",
                "unevaluatedProperties": false,
                "required": [
                  "order"
                ],
                "properties": {
                  "order": {
                    "enum": [
                      "top-to-bottom",
                      "bottom-to-top"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "connection": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "network"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "to"
                ]
              },
              {
                "required": [
                  "network"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "not-connected"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "to"
                  ]
                },
                {
                  "required": [
                    "network"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "nvlink",
                  "power",
                  "cooling"
                ]
              }
            }
          },
          "then": {
            "required": [
              "to"
            ],
            "not": {
              "required": [
                "network"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "alternative": {
                "const": true
              }
            },
            "required": [
              "alternative"
            ]
          },
          "then": {
            "required": [
              "note",
              "network"
            ]
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "from",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id",
          "description": "Component id."
        },
        "to": {
          "$ref": "#/$defs/id",
          "description": "Component id. Omit for a port that the guide marks as not connected."
        },
        "network": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "network",
            "not-connected",
            "nvlink",
            "power",
            "cooling"
          ]
        },
        "description": {
          "type": "string"
        },
        "alternative": {
          "type": "boolean",
          "description": "A conflicting reading from another part of the guide; kept for the record and shown as a conflict, not as fact."
        }
      }
    },
    "traySlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "face",
        "x",
        "z",
        "w",
        "d",
        "h"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "Which instance, 1-based. Omit for a component with no stated count."
        },
        "label": {
          "type": "string",
          "pattern": "\\S",
          "description": "NVIDIA's name for this instance, e.g. 'GPU0 (HPM_L GPU_0)'."
        },
        "face": {
          "enum": [
            "top",
            "front"
          ],
          "description": "top: lies inside the tray. front: sits in the front panel."
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "description": "Left (-0.5) to right (+0.5), seen from the front."
        },
        "z": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "description": "Rear (-0.5) to front (+0.5)."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bottom (0) to top (1) of the tray. Front parts: centre height. Top parts: if set, bottom elevation, and h is then a fraction of the tray height (for stacked parts such as PSUs)."
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "d": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "indicators": {
          "type": "array",
          "description": "Status LEDs drawn on the part's front face.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color",
              "label"
            ],
            "properties": {
              "color": {
                "enum": [
                  "green",
                  "amber"
                ]
              },
              "label": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    "trayLayout": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "slots",
        "assumed"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "notPlaced": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "reason"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/id"
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/traySlot"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trayPoint"
          },
          "description": "Named spots on the tray, e.g. rear connectors, for links that end there."
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trayLink"
          },
          "description": "Instance-level connections inside the tray: the 'veins' layer."
        },
        "heightRU": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Height of the tray in rack units; 1 if omitted."
        }
      }
    },
    "linkEnd": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "component"
          ]
        },
        {
          "required": [
            "point"
          ]
        }
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "point": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "trayLink": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pcie",
            "c2c",
            "clink",
            "nvlink",
            "coolant",
            "power"
          ]
        },
        "from": {
          "$ref": "#/$defs/linkEnd"
        },
        "to": {
          "$ref": "#/$defs/linkEnd"
        }
      }
    },
    "trayPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "x",
        "z"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "z": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        }
      }
    },
    "rearPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "x",
        "w"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "from": {
          "type": "string",
          "pattern": "^(top|bottom|[a-z0-9-]+\\.[1-9][0-9]*)$"
        },
        "to": {
          "type": "string",
          "pattern": "^(top|bottom|[a-z0-9-]+\\.[1-9][0-9]*)$"
        },
        "at": {
          "enum": [
            "top",
            "bottom",
            "below"
          ],
          "description": "A short part fixed at the top or bottom of the stack, or below it, instead of a from/to span."
        },
        "heightRU": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layer": {
          "enum": [
            "parts",
            "structure"
          ],
          "description": "Which layer toggle shows it (default parts)."
        }
      },
      "oneOf": [
        {
          "required": [
            "from",
            "to"
          ]
        },
        {
          "required": [
            "at",
            "heightRU"
          ]
        }
      ]
    },
    "rearLayout": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "parts",
        "assumed"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rearPart"
          }
        },
        "unitConnectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unitConnector"
          }
        }
      }
    },
    "unitConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "component",
        "x",
        "w",
        "kind"
      ],
      "properties": {
        "unit": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "kind": {
          "enum": [
            "nvlink",
            "cooling",
            "power",
            "ac"
          ]
        },
        "toPart": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into rearLayout.parts this connector links to; omitted for AC whips, which leave the rack."
        }
      }
    },
    "pcieDevice": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "label",
        "bus",
        "component"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "bus": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
        },
        "interface": {
          "type": "string",
          "pattern": "^en[A-Za-z0-9]+$"
        },
        "rdma": {
          "type": "string",
          "pattern": "^mlx5_[0-9]+$"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "component",
        "steps"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "source"
            ],
            "properties": {
              "text": {
                "type": "string",
                "pattern": "\\S"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "target": {
                "type": "string",
                "description": "Selection path to highlight for this step, on an example unit."
              }
            }
          }
        }
      }
    }
  }
}
