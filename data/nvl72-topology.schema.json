{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/omerfsen/vera-rubin-nvl72-explorer/data/nvl72-topology.schema.json",
  "title": "NVIDIA DGX Vera Rubin NVL72 topology",
  "description": "Components, networks, rack layout and connections of a DGX VR NVL72 rack. Every fact carries a source; anything the guide does not state is marked assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "networks",
    "components",
    "rackLayout",
    "connections"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "document",
        "retrieved"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "date",
            "urls"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            },
            "pdfPages": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            },
            "pdfPagesNote": {
              "type": "string"
            }
          }
        },
        "retrieved": {
          "type": "string",
          "format": "date"
        },
        "serviceManual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "date",
            "urls"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "urls": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "minItems": 1
            },
            "pdfPages": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "maintainer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "repository",
            "license"
          ],
          "description": "Who maintains this dataset (not a fact about the rack).",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "github": {
              "type": "string",
              "format": "uri"
            },
            "linkedin": {
              "type": "string",
              "format": "uri"
            },
            "repository": {
              "type": "string",
              "format": "uri"
            },
            "license": {
              "type": "string"
            }
          }
        }
      }
    },
    "networks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/network"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "rackLayout": {
      "$ref": "#/$defs/rackLayout"
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connection"
      }
    },
    "trayLayouts": {
      "type": "object",
      "description": "Schematic interior layouts, keyed by tray component id.",
      "additionalProperties": {
        "$ref": "#/$defs/trayLayout"
      }
    },
    "rearLayout": {
      "$ref": "#/$defs/rearLayout"
    },
    "pcieDevices": {
      "type": "array",
      "description": "Table 2.4 of the guide, verbatim, mapped to parts.",
      "items": {
        "$ref": "#/$defs/pcieDevice"
      }
    },
    "procedures": {
      "type": "array",
      "description": "Customer-replaceable unit procedures from the service manual.",
      "items": {
        "$ref": "#/$defs/procedure"
      }
    },
    "nvlinkFabric": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "endpoints",
        "through",
        "description"
      ],
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "through": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "textSources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "components",
          "kind",
          "details"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "kind": {
            "enum": [
              "conflict",
              "gap"
            ]
          },
          "details": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "software": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/software"
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "commandNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage",
        "factoryReset",
        "source"
      ],
      "properties": {
        "usage": {
          "type": "string"
        },
        "factoryReset": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "safety": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/safety"
      }
    },
    "glossary": {
      "description": "Terms and abbreviations as NVIDIA's documents expand or define them. A term the documents do not define is left out.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/glossaryTerm"
      }
    },
    "changelog": {
      "description": "What changed in NVIDIA's documents and how this data followed, newest first. A new document date or fingerprint in data/doc-fingerprints.json needs an entry here; tests/changelog.test.ts checks it.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/changelogEntry"
      }
    }
  },
  "$defs": {
    "glossaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "term",
        "definition",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "term": {
          "description": "The term as the documents write it; matched whole-word and case-sensitively in the panel text.",
          "type": "string",
          "pattern": "^\\S+$"
        },
        "aliases": {
          "description": "Other spellings matched the same way, such as ToR for TOR.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\S+$"
          }
        },
        "expansion": {
          "description": "What the abbreviation stands for, as the documents expand it.",
          "type": "string",
          "pattern": "\\S"
        },
        "definition": {
          "description": "Short definition taken from the sentence in the source section that defines the term.",
          "type": "string",
          "pattern": "\\S"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "id": {
      "description": "Lowercase kebab-case. Dots and slashes are reserved for instance paths (compute-tray.7/gpu.2).",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "section"
      ],
      "properties": {
        "url": {
          "description": "A page of the DGX VR NVL72 User Guide or Service Manual, with the section anchor, or one of their PDFs.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://docs\\.nvidia\\.com/dgx/(dgxvr-user-guide/((hardware|networking|storage|software|safety|control-config|compute-tray-redfish-commands|rack-reboot-sequence|health-check)\\.html(#[a-z0-9-]+)?|dgxvr-user-guide\\.pdf)|dgxvr-service-manual/((index|introduction|psu-replacement|pmm-replacement|cache-replacement|compute-battery-replacement|switch-battery-replacement)\\.html(#[a-z0-9-]+)?|dgxvr-service-manual\\.pdf))$"
        },
        "section": {
          "type": "string",
          "pattern": "\\S",
          "description": "Section number and title, plus table or figure."
        },
        "figure": {
          "description": "One of the 13 official figure files under https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/. Only hot-linked, and only when SHOW_OFFICIAL_FIGURES is on.",
          "enum": [
            "hardware-rack-configuration-VRNVL72.png",
            "hardware-rack-rear-VRNVL72.png",
            "hardware-compute-tray-vrnvl72.png",
            "hardware-compute-tray-block-diagram-VRNVL72.png",
            "hardware-compute-tray-top-VRNVL72.png",
            "hardware-compute-tray-front-VRNVL72.png",
            "hardware-nvlink-switch-tray-VRNVL72.png",
            "hardware-power-shelf-VRNVL72.png",
            "hardware-tor-ethernet-VRNVL72.png",
            "network-port-numbers-VRNVL72.png",
            "network-port-types-VRNVL72.png",
            "network-port-labels-1-VRNVL72.png",
            "network-port-labels-2-VRNVL72.png"
          ]
        }
      }
    },
    "provenance": {
      "description": "A fact needs a source. assumed=true means the guide does not state it; a note is then required.",
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "assumed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "source"
      ],
      "if": {
        "properties": {
          "assumed": {
            "const": true
          }
        },
        "required": [
          "assumed"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "unit": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source",
          "description": "Overrides the component source for this one spec."
        },
        "assumed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "if": {
        "properties": {
          "assumed": {
            "const": true
          }
        },
        "required": [
          "assumed"
        ]
      },
      "then": {
        "required": [
          "note"
        ]
      }
    },
    "network": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "if": {
            "properties": {
              "fabric": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "fabricSource"
            ]
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "number",
        "name",
        "description",
        "fabric"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "number": {
          "description": "Number used in the guide's network list and port figure.",
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "fabric": {
          "description": "null when the guide does not name the fabric for this network.",
          "enum": [
            "InfiniBand",
            "Ethernet",
            null
          ]
        },
        "fabricSource": {
          "$ref": "#/$defs/source",
          "description": "Where the fabric is stated, when that is not the network's own source."
        }
      }
    },
    "componentType": {
      "enum": [
        "rack",
        "compute-tray",
        "switch-tray",
        "power-shelf",
        "tor-switch",
        "cpu",
        "gpu",
        "nic",
        "dpu",
        "drive",
        "switch-asic",
        "psu",
        "bmc",
        "controller",
        "port",
        "cable-cartridge",
        "manifold",
        "bus-bar",
        "battery",
        "memory",
        "board",
        "connector",
        "structure"
      ]
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "count",
        "parent",
        "description",
        "function",
        "networks",
        "specs",
        "references"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/componentType"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "description": "Instances per parent instance. null when the guide does not state it.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "parent": {
          "description": "Parent component id, or null for the rack itself.",
          "oneOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "networks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/spec"
          }
        },
        "rearSide": {
          "description": "Sits at the rear of the rack.",
          "type": "boolean"
        },
        "textSources": {
          "description": "Extra sources for facts in description and function that the main source does not state.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "description": "Every section of NVIDIA's documents about this component, generated by scripts/references.mjs.",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "numbering": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "source"
          ],
          "description": "The first number NVIDIA uses for these parts (0 for GPU0..GPU3). Paths in the URL stay 1-based.",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "source": {
              "$ref": "#/$defs/source"
            }
          }
        },
        "assumedNetworks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true,
          "description": "Networks in `networks` that are this app's reading rather than stated for this part; the component's note says why."
        }
      }
    },
    "rackLayout": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "order",
        "groups"
      ],
      "properties": {
        "order": {
          "const": "top-to-bottom"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "count"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/id"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "heightsRU": {
          "description": "Height per component id in rack units. Each value carries its own provenance.",
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "#/$defs/provenance"
              }
            ],
            "type": "object",
            "unevaluatedProperties": false,
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "numbering": {
          "allOf": [
            {
              "$ref": "#/$defs/provenance"
            }
          ],
          "type": "object",
          "unevaluatedProperties": false,
          "required": [
            "scheme"
          ],
          "properties": {
            "scheme": {
              "const": "top-to-bottom-per-type"
            },
            "overrides": {
              "type": "object",
              "description": "Per-type numbering that differs from the default scheme.",
              "additionalProperties": {
                "allOf": [
                  {
                    "$ref": "#/$defs/provenance"
                  }
                ],
                "type": "object",
                "unevaluatedProperties": false,
                "required": [
                  "order"
                ],
                "properties": {
                  "order": {
                    "enum": [
                      "top-to-bottom",
                      "bottom-to-top"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "connection": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "network"
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "to"
                ]
              },
              {
                "required": [
                  "network"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "not-connected"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "to"
                  ]
                },
                {
                  "required": [
                    "network"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "nvlink",
                  "power",
                  "cooling"
                ]
              }
            }
          },
          "then": {
            "required": [
              "to"
            ],
            "not": {
              "required": [
                "network"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "alternative": {
                "const": true
              }
            },
            "required": [
              "alternative"
            ]
          },
          "then": {
            "required": [
              "note",
              "network"
            ]
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "id",
        "from",
        "kind",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id",
          "description": "Component id."
        },
        "to": {
          "$ref": "#/$defs/id",
          "description": "Component id. Omit for a port that the guide marks as not connected."
        },
        "network": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "network",
            "not-connected",
            "nvlink",
            "power",
            "cooling"
          ]
        },
        "description": {
          "type": "string"
        },
        "alternative": {
          "type": "boolean",
          "description": "A conflicting reading from another part of the guide; kept for the record and shown as a conflict, not as fact."
        }
      }
    },
    "traySlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "face",
        "x",
        "z",
        "w",
        "d",
        "h"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "description": "Which instance, 1-based. Omit for a component with no stated count."
        },
        "label": {
          "type": "string",
          "pattern": "\\S",
          "description": "NVIDIA's name for this instance, e.g. 'GPU0 (HPM_L GPU_0)'."
        },
        "face": {
          "enum": [
            "top",
            "front"
          ],
          "description": "top: lies inside the tray. front: sits in the front panel."
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "description": "Left (-0.5) to right (+0.5), seen from the front."
        },
        "z": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5,
          "description": "Rear (-0.5) to front (+0.5)."
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bottom (0) to top (1) of the tray. Front parts: centre height. Top parts: if set, bottom elevation, and h is then a fraction of the tray height (for stacked parts such as PSUs)."
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "d": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "indicators": {
          "type": "array",
          "description": "Status LEDs drawn on the part's front face. unlit=true draws one switched off, for an LED the documents describe only in a failure state.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "color",
              "label"
            ],
            "properties": {
              "color": {
                "enum": [
                  "green",
                  "amber"
                ]
              },
              "label": {
                "type": "string",
                "pattern": "\\S"
              },
              "unlit": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "trayLayout": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "slots",
        "assumed"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "notPlaced": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component",
              "reason"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/id"
              },
              "reason": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/traySlot"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trayPoint"
          },
          "description": "Named spots on the tray, e.g. rear connectors, for links that end there."
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trayLink"
          },
          "description": "Instance-level connections inside the tray: the 'veins' layer."
        },
        "heightRU": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Height of the tray in rack units; 1 if omitted."
        }
      }
    },
    "linkEnd": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "component"
          ]
        },
        {
          "required": [
            "point"
          ]
        }
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "point": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "trayLink": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "kind",
        "from",
        "to"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pcie",
            "c2c",
            "clink",
            "nvlink",
            "coolant",
            "power"
          ]
        },
        "from": {
          "$ref": "#/$defs/linkEnd"
        },
        "to": {
          "$ref": "#/$defs/linkEnd"
        }
      }
    },
    "trayPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "x",
        "z"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "z": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        }
      }
    },
    "rearPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "x",
        "w"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "from": {
          "type": "string",
          "pattern": "^(top|bottom|[a-z0-9-]+\\.[1-9][0-9]*)$"
        },
        "to": {
          "type": "string",
          "pattern": "^(top|bottom|[a-z0-9-]+\\.[1-9][0-9]*)$"
        },
        "at": {
          "enum": [
            "top",
            "bottom",
            "below"
          ],
          "description": "A short part fixed at the top or bottom of the stack, or below it, instead of a from/to span."
        },
        "heightRU": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "layer": {
          "enum": [
            "parts",
            "structure"
          ],
          "description": "Which layer toggle shows it (default parts)."
        }
      },
      "oneOf": [
        {
          "required": [
            "from",
            "to"
          ]
        },
        {
          "required": [
            "at",
            "heightRU"
          ]
        }
      ]
    },
    "rearLayout": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "parts",
        "assumed"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rearPart"
          }
        },
        "unitConnectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unitConnector"
          }
        }
      }
    },
    "unitConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "component",
        "x",
        "w",
        "kind"
      ],
      "properties": {
        "unit": {
          "$ref": "#/$defs/id"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "kind": {
          "enum": [
            "nvlink",
            "cooling",
            "power",
            "ac"
          ]
        },
        "toPart": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into rearLayout.parts this connector links to; omitted for AC whips, which leave the rack."
        }
      }
    },
    "pcieDevice": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "label",
        "bus",
        "component"
      ],
      "properties": {
        "label": {
          "type": "string",
          "pattern": "\\S"
        },
        "bus": {
          "type": "string",
          "pattern": "^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\\.[0-7]$"
        },
        "interface": {
          "type": "string",
          "pattern": "^en[A-Za-z0-9]+$"
        },
        "rdma": {
          "type": "string",
          "pattern": "^mlx5_[0-9]+$"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "description": "Other spellings NVIDIA's figures print for this label (see the row's note and the open questions); the figures do not say which bus each spelling belongs to."
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "component",
        "steps",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "component": {
          "$ref": "#/$defs/id"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "source"
            ],
            "properties": {
              "text": {
                "type": "string",
                "pattern": "\\S"
              },
              "source": {
                "$ref": "#/$defs/source"
              },
              "target": {
                "type": "string",
                "description": "Selection path to highlight for this step, on an example unit."
              },
              "command": {
                "type": "string",
                "description": "A command shown with the step, verbatim from the guide."
              }
            }
          }
        },
        "kind": {
          "enum": [
            "service",
            "operation"
          ]
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "section",
        "html"
      ],
      "properties": {
        "document": {
          "enum": [
            "user-guide",
            "service-manual"
          ]
        },
        "section": {
          "type": "string",
          "pattern": "\\S"
        },
        "html": {
          "type": "string",
          "pattern": "^https://docs\\.nvidia\\.com/dgx/dgxvr-(user-guide|service-manual)/"
        },
        "pdf": {
          "type": "string",
          "pattern": "^https://docs\\.nvidia\\.com/dgx/dgxvr-(user-guide/dgxvr-user-guide|service-manual/dgxvr-service-manual)\\.pdf#page=[1-9][0-9]*$"
        },
        "figures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-rack-configuration-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-rack-rear-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-compute-tray-vrnvl72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-compute-tray-block-diagram-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-compute-tray-top-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-compute-tray-front-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-nvlink-switch-tray-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-power-shelf-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/hardware-tor-ethernet-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/network-port-numbers-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/network-port-types-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/network-port-labels-1-VRNVL72.png",
              "https://docs.nvidia.com/dgx/dgxvr-user-guide/_images/network-port-labels-2-VRNVL72.png"
            ]
          }
        }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "runsOn",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "runsOn": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "partOf": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "note": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "group",
        "purpose",
        "command",
        "appliesTo",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "description": "Verbatim from the guide."
        },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "text",
        "components",
        "procedures",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "procedures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "changelogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "document",
        "reflects",
        "sections",
        "summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "description": "The day the data changed.",
          "type": "string",
          "format": "date"
        },
        "document": {
          "description": "The NVIDIA document the data followed, or \"app-data\" for a change to the data that follows no single document.",
          "enum": [
            "user-guide",
            "service-manual",
            "app-data"
          ]
        },
        "reflects": {
          "description": "The version of each NVIDIA document the data matched after this change: its date, and the SHA-256 of its PDF when known.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document",
              "date"
            ],
            "properties": {
              "document": {
                "enum": [
                  "user-guide",
                  "service-manual"
                ]
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "note": {
                "description": "How sure the date or the SHA-256 is, when it was not read directly from the PDF at the time.",
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        },
        "sections": {
          "description": "The sections of NVIDIA's documents this change touched. May be empty for an app-data entry.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "summary": {
          "description": "What changed in this data.",
          "type": "string",
          "pattern": "\\S"
        },
        "commit": {
          "description": "Git commit of the change in this repository.",
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "pr": {
          "description": "Pull request number in this repository.",
          "type": "integer",
          "minimum": 1
        },
        "issue": {
          "description": "Issue number in this repository, e.g. the \"NVIDIA documentation changed\" issue.",
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
