    {
      "name": "nvl72_get_network",
      "title": "Get one network",
      "description": "Returns one of the rack's seven networks (for example computenet or ipminet): what it is for, its fabric (InfiniBand or Ethernet, or null when the documents do not say), and every connection on it with the port and source. Connections with \"alternative\": true are a conflicting reading kept from NVIDIA's documents, not fact. Use nvl72_overview to list the networks.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "network": {
            "type": "string",
            "enum": [
              "externalnet",
              "internalnet",
              "dgxnet",
              "ipminet",
              "computenet",
              "storagenet",
              "failovernet"
            ],
            "description": "Network id, e.g. \"computenet\"."
          }
