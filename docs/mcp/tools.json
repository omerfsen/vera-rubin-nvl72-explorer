{
  "tools": [
    {
      "name": "nvl72_overview",
      "title": "Rack overview",
      "description": "Summarises the whole DGX Vera Rubin NVL72 rack: the source documents and their dates, the units in the rack with how many of each, per-rack totals of the main parts (GPUs, CPUs, NICs, switch ASICs, PSUs), and the seven networks. Takes no arguments and changes nothing. Start here; use nvl72_get_component for one part, nvl72_rack_layout for positions in the rack.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "urls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "title",
                "date",
                "urls"
              ],
              "additionalProperties": false
            }
          },
          "totalRU": {
            "type": "number"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "count": {
                  "type": "number"
                }
              },
              "required": [
                "component",
                "name",
                "count"
              ],
              "additionalProperties": false
            }
          },
          "totalsPerRack": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "component": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "total": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "component",
                "name",
                "total"
              ],
              "additionalProperties": false
            }
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "fabric": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "fabric"
              ],
              "additionalProperties": false
            }
          },
          "explorer": {
            "type": "string"
          },
          "disclaimer": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "documents",
          "totalRU",
          "units",
          "totalsPerRack",
          "networks",
          "explorer",
          "disclaimer"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Rack overview",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "nvl72_search",
      "title": "Search the rack data",
      "description": "Finds parts, networks, procedures, BMC commands and PCIe rows whose name, id, description, label, bus address or interface name contain every word of the query (case-insensitive). Returns ids to pass to the nvl72_get_* tools, best matches first; it does not return the facts themselves. Use it when you do not know the exact id; use nvl72_get_component directly when you do.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Words to look for, e.g. \"bluefield port\" or \"0001:03:00.0\". Up to 80 characters."
          },
          "limit": {
            "default": 10,
            "description": "Most results to return, 1 to 25.",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "component",
                    "network",
                    "procedure",
                    "command",
                    "pcie"
                  ]
                },
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "next": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "id",
                "title",
                "next"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "results",
          "truncated"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "title": "Search the rack data",
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "nvl72_get_component",
      "title": "Get one part",
      "description": "Returns everything the dataset holds about one part of the rack: what it is and does, how many per parent and per rack, its parent and the parts inside it, networks, specs, connections, PCIe rows, software that runs on it, BMC commands and procedures for it, safety notes, open questions, and every NVIDIA document section about it. Each fact has its source; \"assumed\": true marks a reading the documents do not state. Use nvl72_search first if you do not know the id.",
