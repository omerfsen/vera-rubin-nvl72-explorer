              "ct-port-bf4-rj45",
              "ct-port-bmc-1gbe",
              "ct-port-lan-1gbe",
              "compute-tray-battery",
              "socamm",
              "internal-manifold",
              "power-distribution-board",
              "ct-nvlink-connectors",
              "ct-cold-water-inlet",
              "ct-hot-water-outlet",
              "ct-bus-bar-connector",
              "switch-tray",
              "nvswitch-asic",
              "switch-bmc",
              "cpu-erot",
              "st-port-rs232",
              "st-port-bmc-eth",
              "st-port-switch-mgmt",
              "st-port-leakage",
              "switch-tray-battery",
