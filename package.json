{
  "name": "vera-rubin-nvl72-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial interactive 3D explorer of the NVIDIA DGX Vera Rubin NVL72 rack.",
  "author": "Omer Sen",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:refs": "node scripts/references.mjs",
    "e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "i18n:en": "node scripts/i18n-content.mjs",
    "mcp:build": "vite build --config mcp/vite.config.ts",
    "mcp:docs": "MCP_DOCS_WRITE=1 vitest run tests/mcp-docs.test.ts",
    "mcp:e2e": "npm run mcp:build && node scripts/mcp-wire.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "mediabunny": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
